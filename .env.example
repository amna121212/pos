# Copy to .env for a local run. Never commit real values.
POS_DB_USER=pos_app
POS_DB_PASSWORD=replace-with-the-pos-password
POS_DB_HOST=127.0.0.1
POS_DB_PORT=5432
POS_DB_NAME=retail_pos_db

# POS_SECRET_KEY=optional-fixed-session-key
POS_SESSION_COOKIE_SECURE=1
POS_SIGNUP_ENABLED=1
FLASK_APP=wsgi:app
