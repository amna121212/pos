# Copy to /etc/pos/pos.env on the server. Do not commit a real password.
# The application user posapp should be able to read that file, and other users should not.
POS_DB_USER=pos_app
POS_DB_PASSWORD=replace-with-the-pos-password
POS_DB_HOST=127.0.0.1
POS_DB_PORT=5432
POS_DB_NAME=retail_pos_db

# Session signing key. Leave unset and the app writes a random key to
# instance/secret_key with 0600 permissions on first start.
# POS_SECRET_KEY=replace-with-64-hex-characters

# Send the session cookie only over HTTPS. Set to 0 for plain-HTTP local testing.
POS_SESSION_COOKIE_SECURE=1

# Public registration. Set to 0 to close self-service signup on a shared server;
# the /signup route then returns 404 and the sign-in page drops the link.
POS_SIGNUP_ENABLED=1
